# Allowed origins for CORS API access
# Separate with commas if there are multiple origins
ORIGINS="http://localhost:5173,http://localhost:3000"

# Port for the server to run on
PORT=3000

# MongoDB connection URI (e.g., MongoDB Atlas or local)
# Replace <username>, <password>, <cluster-url>, and <database-name> with actual credentials
MONGODB_URI="mongodb://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority"
